                "pageno": {
                    "type": "integer", "description": "Page number (default: 1)",
                    "default": 1,
                },
                "language": {
                    "type": "string",
                    "description": "Language code (e.g., 'en', 'zh', 'all')",
                    "default": "all",
                },
                "categories": {
                    "type": "string",
                    "description": (
                        "Comma-separated categories: general, news, images, videos, "
                        "science, files, it, social media, music, map (default: all)"
                    ),
                },
                "time_range": {
