        },
    },
]


def make_response(req_id, result):
    return json.dumps({"jsonrpc": "2.0", "id": req_id, "result": result})


def make_error(req_id, code, message):
    return json.dumps(
        {"jsonrpc": "2.0", "id": req_id, "error": {"code": code, "message": message}}
    )


def text_content(text):
    return {"content": [{"type": "text", "text": text}]}


def handle_request(msg):
    req_id = msg.get("id")
    method = msg.get("method", "")
    params = msg.get("params", {})

    if method == "initialize":
        return make_response(req_id, {
            "protocolVersion": "2024-11-05",
            "capabilities": {"tools": {}},
            "serverInfo": {
                "name": "searxng-python-bridge",
                "version": "2.0.1",
            },
        })

    elif method == "tools/list":
        return make_response(req_id, {"tools": TOOLS})

    elif method == "tools/call":
        name = params.get("name", "")
        args = params.get("arguments", {})

        if name == "searxng_web_search":
            query = args.get("query", "")
            if not query:
                return make_error(req_id, -32602, "Missing required parameter: query")
            data = search_searxng(
                query,
                pageno=args.get("pageno", 1),
                language=args.get("language", "all"),
                categories=args.get("categories", ""),
                time_range=args.get("time_range", ""),
            )
            return make_response(req_id, text_content(
                format_results(data, query, args.get("pageno", 1))))

        elif name == "searxng_web_extract":
            url = args.get("url", "")
            if not url:
                return make_error(req_id, -32602, "Missing required parameter: url")
            result = extract_url(url, char_limit=args.get("char_limit", EXTRACT_CHAR_LIMIT))
            return make_response(req_id, text_content(result))

        return make_error(req_id, -32601, f"Unknown tool: {name}")

    elif method == "ping":
        return make_response(req_id, {})

    elif method in ("notifications/initialized",) or method.startswith("notifications/"):
        return None

    return make_error(req_id, -32601, f"Unknown method: {method}")


# ── HTTP Transport (for llama.cpp WebUI, browser-based clients) ──────────

class MCPHTTPHandler(BaseHTTPRequestHandler):
    """Handle JSON-RPC requests over HTTP (StreamableHTTP transport)."""

    def log_message(self, fmt, *args):
        if os.environ.get("SEARXNG_MCP_DEBUG"):
            print(f"[mcp-http] {args[0]}", file=sys.stderr)

    def do_OPTIONS(self):
        self.send_response(204)
        self._cors()
        self.end_headers()

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length) if length else b""

        try:
            msg = json.loads(body)
        except json.JSONDecodeError:
            self.send_error(400, "Invalid JSON")
            return

        if isinstance(msg, list):
            resp = json.dumps({
                "jsonrpc": "2.0", "id": None,
                "error": {"code": -32600, "message": "Batch requests not supported"}
            })
        else:
            try:
                resp = handle_request(msg)
            except Exception as e:
                resp = make_error(msg.get("id"), -32603, f"Internal error: {e}")

        if resp is None:
            self.send_response(202)
            self._cors()
            self.end_headers()
            return

        body_bytes = resp.encode("utf-8")
        self.send_response(200)
        self._cors()
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body_bytes)))
        self.end_headers()
        self.wfile.write(body_bytes)

    def do_GET(self):
        info = json.dumps({
            "server": "searxng-python-bridge",
            "version": "2.0.1",
            "tools": [t["name"] for t in TOOLS],
            "transport": "streamable-http",
        }).encode("utf-8")
        self.send_response(200)
        self._cors()
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(info)))
        self.end_headers()
        self.wfile.write(info)

    def do_DELETE(self):
        self.send_response(200)
        self._cors()
        self.end_headers()

    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers",
                         "Content-Type, MCP-Protocol-Version, Mcp-Session-Id, Accept")
        self.send_header("Access-Control-Max-Age", "86400")


def run_http_server(host, port):
    print(f"[searxng-mcp] HTTP server on http://{host}:{port}/mcp", file=sys.stderr)
    print(f"[searxng-mcp] Tools: {[t['name'] for t in TOOLS]}", file=sys.stderr)
    server = HTTPServer((host, port), MCPHTTPHandler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n[searxng-mcp] shutting down", file=sys.stderr)
        server.shutdown()


def run_stdio():
    debug = os.environ.get("SEARXNG_MCP_DEBUG", "").lower() in ("1", "true", "yes")
    buffer = ""
    for line in sys.stdin:
        if not line.strip():
            continue
        buffer += line
        try:
            msg = json.loads(buffer)
            buffer = ""
        except json.JSONDecodeError:
            continue

        if not isinstance(msg, dict):
            if debug:
                print(f"[searxng-mcp] ignoring non-dict: {type(msg)}", file=sys.stderr)
            continue

        try:
            resp = handle_request(msg)
        except Exception as e:
            if debug:
                import traceback
                traceback.print_exc(file=sys.stderr)
            resp = make_error(msg.get("id"), -32603, f"Internal error: {e}")

        if resp is not None:
            sys.stdout.write(resp + "\n")
            sys.stdout.flush()


def main():
    parser = argparse.ArgumentParser(
        description="SearXNG MCP Bridge — search + extract via SearXNG"
    )
    parser.add_argument(
        "--http-port", type=int, default=None,
        help="Run as HTTP server on this port (for llama.cpp WebUI, browser clients)"
    )
    parser.add_argument(
        "--http-host", type=str, default="127.0.0.1",
        help="HTTP bind address (default: 127.0.0.1)"
    )
    args = parser.parse_args()

    if args.http_port:
        run_http_server(args.http_host, args.http_port)
    else:
        run_stdio()


if __name__ == "__main__":
    main()
