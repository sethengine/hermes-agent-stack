# ── Cache ───────────────────────────────────────────────────────────────
class TTLCache:
    """Thread-safe TTL cache with LRU eviction."""
    def __init__(self, maxsize=200, ttl=300):
        self._cache = OrderedDict()
        self._lock = Lock()
        self._maxsize = maxsize
        self._ttl = ttl

    def _key(self, *args, **kwargs):
        raw = json.dumps({"args": args, "kwargs": {k: v for k, v in sorted(kwargs.items())}}, sort_keys=True)
        return hashlib.sha256(raw.encode()).hexdigest()

    def get(self, *args, **kwargs):
        k = self._key(*args, **kwargs)
        with self._lock:
            if k in self._cache:
                val, ts = self._cache[k]
                if time.time() - ts < self._ttl:
                    self._cache.move_to_end(k)
                    return val
                del self._cache[k]
        return None

    def set(self, value, *args, **kwargs):
        k = self._key(*args, **kwargs)
        with self._lock:
            if k in self._cache:
                self._cache.move_to_end(k)
            self._cache[k] = (value, time.time())
            while len(self._cache) > self._maxsize:
                self._cache.popitem(last=False)

search_cache = TTLCache(maxsize=200, ttl=CACHE_TTL_SEARCH)
extract_cache = TTLCache(maxsize=100, ttl=CACHE_TTL_EXTRACT)

# ── HTTP Client ─────────────────────────────────────────────────────────
def http_get(url, params=None, timeout=TIMEOUT, headers=None):
    if _HAS_HTTPX:
        with httpx.Client(timeout=timeout, headers=headers or {},
                          follow_redirects=True) as c:
            r = c.get(url, params=params); r.raise_for_status()
        return r
    if params: url = f"{url}?{urlencode(params)}"
    req = Request(url, headers=headers or {})
    try:
        r = urlopen(req, timeout=timeout)
        body = r.read().decode("utf-8", errors="replace")
    except UrllibHTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        raise _HTTPError(e.code, body) from e
    except URLError as e:
        raise _TimeoutError(str(e)) from e
    r.text = body; r.json = lambda: json.loads(body)
    r.status_code = r.status; r.headers = dict(r.headers)
    return r

class _HTTPError(Exception):
    def __init__(self, c, b): self.code = c; self.body = b; super().__init__(f"HTTP {c}")
class _TimeoutError(Exception):
    pass

# ── HTML Stripper ───────────────────────────────────────────────────────
class _Stripper(HTMLParser):
    def __init__(s):
        super().__init__(); s._p = []; s._k = 0
    def handle_starttag(s, t, _):
        if t in ("script","style","noscript","svg","canvas"): s._k += 1
    def handle_endtag(s, t):
        if t in ("script","style","noscript","svg","canvas"): s._k = max(0, s._k-1)
        elif t in ("p","br","li","div","tr","h1","h2","h3","h4","h5","h6","section","article"):
            s._p.append("\n")
    def handle_data(s, d):
        if s._k == 0: s._p.append(d)
    def get_text(s):
        r = "".join(s._p); r = re.sub(r"[ \t\r\f\v]+", " ", r)
        return re.sub(r"\n{3,}", "\n\n", r).strip()

def strip_html(h):
    p = _Stripper()
    try: p.feed(h)
    except: pass
    return p.get_text()

# ══════════════════════════════════════════════════════════════════════════
# FUZZY DEDUP
# ══════════════════════════════════════════════════════════════════════════

def _fuzzy_ratio(a, b):
    """Simple character-level similarity ratio (0.0-1.0)."""
    a, b = a.lower(), b.lower()
    if a == b: return 1.0
    # Strip common prefixes/suffixes that differ across engines
    for s in (" | ", " - ", " ... ", "..."):
        a = a.split(s)[0]; b = b.split(s)[0]
    # Jaccard-like character trigram similarity
    def trigrams(s):
        return set(s[i:i+3] for i in range(len(s)-2))
    ta, tb = trigrams(a), trigrams(b)
    if not ta or not tb: return 0.0
    return len(ta & tb) / len(ta | tb)

def deduplicate(results, threshold=0.85):
    """Remove near-duplicate results by fuzzy title matching."""
    if not results: return results
    deduped = []
    seen_titles = []
    for r in results:
        title = r.get("title", "")
        if not title:
            deduped.append(r)
            continue
        is_dup = False
        for seen in seen_titles:
            if _fuzzy_ratio(title, seen) >= threshold:
                is_dup = True
                break
        if not is_dup:
            deduped.append(r)
            seen_titles.append(title)
    return deduped

# ══════════════════════════════════════════════════════════════════════════
# CATEGORY-AWARE RANKING
# ══════════════════════════════════════════════════════════════════════════

CATEGORY_BOOSTS = {
    # Engine-level boosts (pre-score, additive)
    "arxiv": 0.15,
    "github": 0.10,
    "wikipedia": 0.05,
    "stackoverflow": 0.08,
    "wttr.in": 0.0,
    "unsplash": -0.05,
    "flickr": -0.05,

    # Category boosts for tech queries
    "tech": {
        "github": 0.20, "stackoverflow": 0.15, "arxiv": 0.15,
        "wikipedia": 0.10, "reddit": 0.05, "hackernews": 0.10,
    },
    # Category boosts for news queries
    "news": {
        "reuters": 0.15, "yahoo": 0.10, "wikinews": 0.15,
        "brave.news": 0.10, "bing": 0.05,
    },
    # Category boosts for academic queries
    "scholar": {
        "arxiv": 0.25, "semantic scholar": 0.20, "pubmed": 0.20,
        "wikipedia": 0.10, "google scholar": 0.15,
    },
}

def rank_results(results, query_context="general"):
    """Apply category-aware scoring boosts."""
    ctx_lower = query_context.lower()
    boosts = CATEGORY_BOOSTS.get(ctx_lower, {})

    for r in results:
        engine = (r.get("engine", "") or "").lower()
        base_score = float(r.get("score", 0.5))

        # Apply engine-level boost (skip dict entries)
        for key, boost in CATEGORY_BOOSTS.items():
            if isinstance(boost, (int, float)) and key in engine:
                base_score += boost

        # Apply category-specific boost
        for key, boost in boosts.items():
            if key in engine:
                base_score += boost

        r["score"] = min(base_score, 1.0)

    # Re-sort by score
    results.sort(key=lambda r: r.get("score", 0), reverse=True)
    return results

