# RESEARCH PLAN TOOL
# ══════════════════════════════════════════════════════════════════════════

def research_plan(query, depth="standard"):
    """
    Structured research: breaks query into sub-questions, searches each,
    deduplicates across all results, scores by confidence.
    """
    # Define sub-queries based on query analysis
    sub_queries = _derive_subqueries(query)

    if depth == "quick":
        sub_queries = sub_queries[:2]
    elif depth == "deep":
        sub_queries.extend(_derive_subqueries(query, mode="supplementary"))

    all_results = []
    sections = []

    for sq in sub_queries:
        context = sq.get("context", "general")
        cat = sq.get("categories", "")
        data = federated_search(sq["query"], categories=cat, context=context,
                                max_results=8)
        results = data.get("results", [])
        if results:
            sections.append({
                "question": sq["question"],
                "query": sq["query"],
                "results": results,
                "engines": data.get("engines", []),
            })
            all_results.extend(results)

    # Cross-section dedup
    all_deduped = deduplicate(all_results)
    all_ranked = rank_results(all_deduped)

    # Build output
    lines = [f"# Research Plan: {query}\n"]
    lines.append(f"**Depth:** {depth} | **Sub-queries:** {len(sub_queries)} | **Total unique results:** {len(all_deduped)}\n")

    for i, sec in enumerate(sections, 1):
        lines.append(f"## {i}. {sec['question']}")
        lines.append(f"*Query: `{sec['query']}` | Sources: {', '.join(sec['engines'][:5])}*")
        for j, r in enumerate(sec["results"][:5], 1):
            t, u = r.get("title",""), r.get("url","")
            s = (r.get("content","") or "")[:200].strip()
            sc = r.get("score", 0) * 100
            lines.append(f"{j}. **[{t}]({u})** *(confidence: {sc:.0f}%)*")
            if s: lines.append(f"   {s}")
        lines.append("")

    # Top findings across all sections
    lines.append("## Key Findings (cross-source synthesis)")
    lines.append("")
    top = all_ranked[:5]
    for i, r in enumerate(top, 1):
        t, u = r.get("title",""), r.get("url","")
        lines.append(f"{i}. **[{t}]({u})** — Source: {r.get('engine','?')}")

    return "\n".join(lines)

def _derive_subqueries(query, mode="primary"):
    """Derive sub-queries from a research question."""
    q = query.lower()
    subs = []

    if mode == "primary":
        # Core sub-queries based on query type
        if any(w in q for w in ["vs", "versus", "compare"]):
            # Comparison query
            parts = re.split(r'\s+(?:vs|versus|compare)\s+', query, flags=re.I)
            for p in parts:
                p = p.strip()
                if p:
                    subs.append({"question": f"What is {p}?", "query": p, "context": "general"})
            subs.append({"question": f"{query} comparison", "query": query, "context": "general"})
        elif any(w in q for w in ["best", "top", "recommend", "review"]):
            subs.append({"question": f"Reviews and recommendations for {query}",
                         "query": query, "context": "general"})
            subs.append({"question": f"Latest news about {query}",
                         "query": query, "categories": "news", "context": "news"})
            subs.append({"question": f"Technical details and specs for {query}",
                         "query": f"{query} technical specifications",
                         "context": "tech"})
        elif any(w in q for w in ["how to", "tutorial", "guide", "setup"]):
            subs.append({"question": f"Tutorials and guides for {query}",
                         "query": query, "context": "general"})
            subs.append({"question": f"Common issues and troubleshooting for {query}",
                         "query": f"{query} problems troubleshooting", "context": "tech"})
        else:
            # General research
            subs.append({"question": f"What is {query}?",
                         "query": query, "context": "general"})
            subs.append({"question": f"Latest developments in {query}",
                         "query": f"{query} latest", "categories": "news",
                         "context": "news"})
            subs.append({"question": f"Deep dive: technical/research perspective on {query}",
                         "query": query, "context": "tech"})

    else:
        # Supplementary
        subs.append({"question": f"Academic research on {query}",
                     "query": query, "context": "scholar"})
        subs.append({"question": f"Community discussion about {query}",
                     "query": f"{query} reddit discussion",
                     "context": "tech"})

    return subs

