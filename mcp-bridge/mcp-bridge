def search_searxng(query, pageno=1, language="all", categories="", time_range=""):
    cached = search_cache.get(query=query, pageno=pageno, language=language,
                              categories=categories, time_range=time_range)
    if cached: return cached

    params = {"q": query, "format": "json", "pageno": pageno, "language": language}
    if categories: params["categories"] = categories
    if time_range: params["time_range"] = time_range
    try:
        r = http_get(f"{SEARXNG_URL}/search", params, timeout=TIMEOUT,
                     headers={"User-Agent": UA})
        data = r.json()
        search_cache.set(data, query=query, pageno=pageno, language=language,
                         categories=categories, time_range=time_range)
        return data
    except Exception as e:
        return {"error": str(e), "engine": "searxng"}

def search_duckduckgo(query, max_results=10):
    cached = search_cache.get(query=query, engine="ddg")
    if cached: return cached
    try:
        r = http_get("https://lite.duckduckgo.com/lite/",
                     params={"q": query}, timeout=TIMEOUT,
                     headers={"User-Agent": UA})
        results = []
        for m in re.finditer(
            r'<a[^>]*href="((?:https?:)?//[^"]+)"[^>]*>(.+?)</a>.*?<span[^>]*class="(?:link-text|url)?"[^>]*>(.*?)</span>',
            r.text, re.DOTALL | re.IGNORECASE
        ):
            url, title, snippet_raw = m.groups()
            if url.startswith("//"): url = "https:" + url
            snippet = re.sub(r'<[^>]+>', '', snippet_raw).strip()
            if title and url and "duckduckgo.com" not in url:
                results.append({
                    "title": re.sub(r'<[^>]+>', '', title).strip(),
                    "url": url, "content": snippet[:300],
                    "engine": "duckduckgo", "score": 0.7,
                })
            if len(results) >= max_results: break

        if not results:
            for m in re.finditer(
                r'<a[^>]*href="(https?://[^"]+)"[^>]*class="result-link"[^>]*>(.+?)</a>',
                r.text, re.DOTALL
            ):
                results.append({
                    "title": re.sub(r'<[^>]+>', '', m.group(2)).strip(),
                    "url": m.group(1), "content": "",
                    "engine": "duckduckgo", "score": 0.6,
                })
        out = {"results": results[:max_results], "engine": "duckduckgo"}
        search_cache.set(out, query=query, engine="ddg")
        return out
    except Exception as e:
        return {"error": str(e), "engine": "duckduckgo"}

def search_wikipedia(query, limit=5):
    cached = search_cache.get(query=query, engine="wiki")
    if cached: return cached
    try:
        r = http_get("https://en.wikipedia.org/w/api.php", params={
            "action": "query", "list": "search", "srsearch": query,
            "format": "json", "srlimit": limit,
        }, timeout=TIMEOUT, headers={"User-Agent": UA})
        data = r.json()
        results = []
        for item in data.get("query", {}).get("search", []):
            t = item["title"]
            results.append({
                "title": t,
                "url": f"https://en.wikipedia.org/wiki/{quote_plus(t.replace(' ','_'))}",
                "content": re.sub(r'<[^>]+>', '', item.get("snippet", ""))[:300],
                "engine": "wikipedia", "score": 0.7,
            })
        out = {"results": results, "engine": "wikipedia"}
        search_cache.set(out, query=query, engine="wiki")
        return out
    except Exception as e:
        return {"error": str(e), "engine": "wikipedia"}

def search_arxiv(query, max_results=10):
    cached = search_cache.get(query=query, engine="arxiv")
    if cached: return cached
    try:
        r = http_get("http://export.arxiv.org/api/query", params={
            "search_query": f"all:{query}", "start": 0, "max_results": max_results,
            "sortBy": "relevance",
        }, timeout=TIMEOUT, headers={"User-Agent": UA})
        results = []
        for entry in re.finditer(r'<entry>(.*?)</entry>', r.text, re.DOTALL):
            e = entry.group(1)
            tm = re.search(r'<title>(.*?)</title>', e, re.DOTALL)
            um = re.search(r'<id>(.*?)</id>', e)
            sm = re.search(r'<summary>(.*?)</summary>', e, re.DOTALL)
            pm = re.search(r'<published>(\d{4}-\d{2}-\d{2})', e)
            authors = [a.group(1) for a in re.finditer(r'<name>(.*?)</name>', e)]
            if tm and um:
                results.append({
                    "title": re.sub(r'\s+', ' ', tm.group(1)).strip(),
                    "url": um.group(1),
                    "content": (re.sub(r'\s+', ' ', sm.group(1)).strip()[:300] if sm else ""),
                    "engine": "arxiv", "score": 0.75,
                    "publishedDate": pm.group(1) if pm else "",
                    "authors": authors[:3],
                })
        out = {"results": results, "engine": "arxiv"}
        search_cache.set(out, query=query, engine="arxiv")
        return out
    except Exception as e:
        return {"error": str(e), "engine": "arxiv"}

# ══════════════════════════════════════════════════════════════════════════
# FEDERATED SEARCH (cached → dedup → rank)
# ══════════════════════════════════════════════════════════════════════════

def federated_search(query, pageno=1, language="all", categories="",
                     time_range="", max_results=MAX_RESULTS, context="general"):
    all_results = []
    engines_used = []

    # 1. SearXNG (primary)
    sx = search_searxng(query, pageno, language, categories, time_range)
    if "error" not in sx:
        engines_used.extend(sx.get("engines", [])[:5])
        all_results.extend(sx.get("results", []))
    else:
        ddg = search_duckduckgo(query, max_results)
        if "error" not in ddg:
            engines_used.append("duckduckgo")
            all_results.extend(ddg.get("results", []))

    # 2. Wikipedia supplement
    wiki = search_wikipedia(query, limit=3)
    if "error" not in wiki:
        engines_used.append("wikipedia")
        all_results.extend(wiki.get("results", []))

    # 3. arXiv for academic/technical queries
    if any(kw in query.lower() for kw in
           ["paper","research","study","arxiv","model","algorithm",
            "neural","transformer","diffusion","training","benchmark",
            "dataset","architecture","attention","embedding","fine-tun"]):
        arx = search_arxiv(query, max_results=5)
        if "error" not in arx:
            engines_used.append("arxiv")
            all_results.extend(arx.get("results", []))

    # 4. Deduplicate
    deduped = deduplicate(all_results)

    # 5. Rank (category-aware scoring)
    ranked = rank_results(deduped, query_context=context)

    return {
        "results": ranked[:max_results],
        "engines": engines_used,
        "number_of_results": len(ranked),
    }

# ══════════════════════════════════════════════════════════════════════════
# FORMATTING
# ══════════════════════════════════════════════════════════════════════════

def format_search(data, query, pageno):
    if "error" in data:
        return f"**Search error:** {data['error']}"
    results = data.get("results", [])
    total = data.get("number_of_results", len(results))
    engines = data.get("engines", [])
    lines = [f"**Search:** `{query}`  |  page {pageno}  |  {total} results"]
    if engines: lines.append(f"*Sources:* {', '.join(engines[:8])}")
    if not results:
        return "\n".join(lines) + "\n\n*No results. Try rephrasing.*"
    lines.append("")
    for i, r in enumerate(results[:MAX_RESULTS], 1):
        t, u = r.get("title","Untitled"), r.get("url","")
        s = (r.get("content","") or "")[:300].strip()
        e, sc = r.get("engine","?"), r.get("score",0)
        pub = r.get("publishedDate",""); cat = r.get("category","")
        authors = r.get("authors",[])
        lines.append(f"{i}. **[{t}]({u})**" if u else f"{i}. **{t}**")
        if s: lines.append(f"   {s}")
        meta = [f"Source: {e}"]
        if sc: meta.append(f"Score: {sc:.2f}")
        if pub: meta.append(f"Date: {pub}")
        if authors: meta.append(f"By: {', '.join(authors)}")
        lines.append(f"   *{' | '.join(meta)}*"); lines.append("")
    if len(results) > MAX_RESULTS:
        lines.append(f"*Showing {MAX_RESULTS} of {len(results)} ({total} total)*")
    return "\n".join(lines)

