# WEB EXTRACT
# ══════════════════════════════════════════════════════════════════════════

def extract_url(url, char_limit=EXTRACT_CHARS):
    cached = extract_cache.get(url=url, char_limit=char_limit)
    if cached:
        return f"*[cached]*\n\n{cached}"

    if not url.startswith(("http://","https://")):
        return f"Invalid URL: {url}"
    try:
        r = http_get(url, timeout=25, headers={
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                          "(KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36",
            "Accept": "text/html,application/xhtml+xml,*/*",
        })
    except _TimeoutError: return f"**Timeout:** {url}"
    except _HTTPError as e: return f"**HTTP {e.code}:** {url}"
    except Exception as e: return f"**Error:** {e}"

    html = r.text
    ct = r.headers.get("content-type","")

    # Extract
    text = ""
    title = ""
    author = ""
    date = ""
    if _HAS_TRAF:
        text = trafilatura.extract(html, include_comments=False,
                                   include_tables=True, output_format="markdown",
                                   with_metadata=True) or ""
        if not text:
            text = trafilatura.extract(html, output_format="txt") or ""
        # Metadata
        try:
            meta_json = trafilatura.extract(html, output_format="json", with_metadata=True)
            if meta_json:
                md = json.loads(meta_json)
                title = md.get("title", "")
                author = md.get("author", "")
                date = md.get("date", "")
        except: pass

    if not text:
        text = strip_html(html)

    if not title:
        tm = re.search(r"<title[^>]*>([^<]+)</title>", html, re.I)
        title = tm.group(1).strip() if tm else urlparse(url).netloc

    if not text or len(text) < 50:
        return f"Could not extract content from {url}"

    if len(text) > char_limit:
        text = (f"{text[:char_limit//2]}\n\n"
                f"[... truncated {len(text)} total chars ...]\n\n"
                f"{text[-char_limit//4:]}")

    hostname = urlparse(url).netloc
    extra = ""
    if author: extra += f"  |  By: {author}"
    if date: extra += f"  |  Date: {date}"
    method = "Trafilatura" if _HAS_TRAF else "basic HTML"

    result = (f"**Source:** [{title}]({url})  |  {hostname}"
              f"{extra}\n*Extraction: {method} | {len(html)} bytes → {len(text)} chars*\n\n{text}")

    extract_cache.set(text, url=url, char_limit=char_limit)
    return result

