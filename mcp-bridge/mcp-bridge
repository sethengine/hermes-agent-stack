# MCP HANDLERS
# ══════════════════════════════════════════════════════════════════════════

def ok(req_id, result):
    return json.dumps({"jsonrpc": "2.0", "id": req_id, "result": result})
def err(req_id, code, msg):
    return json.dumps({"jsonrpc": "2.0", "id": req_id, "error": {"code": code, "message": msg}})
def txt(text):
    return {"content": [{"type": "text", "text": text}]}

def handle(msg):
    rid = msg.get("id"); m = msg.get("method", ""); p = msg.get("params", {})
    if m == "initialize":
        return ok(rid, {"protocolVersion": "2024-11-05", "capabilities": {"tools": {}},
                        "serverInfo": {"name": "research-bridge", "version": "4.0.0"}})
    elif m == "tools/list":
        return ok(rid, {"tools": TOOLS})
    elif m == "tools/call":
        n = p.get("name", ""); a = p.get("arguments", {})
        if n == "web_search":
            q = a.get("query", "")
            if not q: return err(rid, -32602, "Missing: query")
            d = federated_search(q, pageno=a.get("pageno", 1),
                                 language=a.get("language", "all"),
                                 categories=a.get("categories", ""),
                                 time_range=a.get("time_range", ""),
                                 context=a.get("context", "general"))
            return ok(rid, txt(format_search(d, q, a.get("pageno", 1))))
        elif n == "web_extract":
            u = a.get("url", "")
            if not u: return err(rid, -32602, "Missing: url")
            return ok(rid, txt(extract_url(u, a.get("char_limit", EXTRACT_CHARS))))
        elif n == "news_search":
            q = a.get("query", "")
            if not q: return err(rid, -32602, "Missing: query")
            d = search_searxng(q, categories="news", time_range=a.get("time_range", "week"))
            return ok(rid, txt(format_search(d, q, 1)))
        elif n == "scholar_search":
            q = a.get("query", "")
            if not q: return err(rid, -32602, "Missing: query")
            d = search_arxiv(q, max_results=min(a.get("max_results", 10), 30))
            return ok(rid, txt(format_search(d, q, 1)))
        elif n == "research_plan":
            q = a.get("query", "")
            if not q: return err(rid, -32602, "Missing: query")
            return ok(rid, txt(research_plan(q, depth=a.get("depth", "standard"))))
        return err(rid, -32601, f"Unknown tool: {n}")
    elif m == "ping":
        return ok(rid, {})
    elif m in ("notifications/initialized",) or m.startswith("notifications/"):
        return None
    return err(rid, -32601, f"Unknown method: {m}")

