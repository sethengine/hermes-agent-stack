# TRANSPORT
# ══════════════════════════════════════════════════════════════════════════

class HTTPHandler(BaseHTTPRequestHandler):
    def log_message(s, f, *a):
        if os.environ.get("MCP_DEBUG"): print(f"[http] {a[0]}", file=sys.stderr)
    def _cors(s):
        s.send_header("Access-Control-Allow-Origin", "*")
        s.send_header("Access-Control-Allow-Methods", "GET,POST,DELETE,OPTIONS")
        s.send_header("Access-Control-Allow-Headers",
                      "Content-Type,MCP-Protocol-Version,Mcp-Session-Id,Accept")
        s.send_header("Access-Control-Max-Age", "86400")
    def do_OPTIONS(s): s.send_response(204); s._cors(); s.end_headers()
    def do_POST(s):
        n = int(s.headers.get("Content-Length", 0))
        b = s.rfile.read(n) if n else b""
        try: msg = json.loads(b)
        except: s.send_error(400); return
        if isinstance(msg, list):
            r = json.dumps({"jsonrpc":"2.0","id":None,"error":{"code":-32600,"message":"No batch"}})
        else:
            try: r = handle(msg)
            except Exception as e: r = err(msg.get("id"), -32603, str(e))
        if r is None: s.send_response(202); s._cors(); s.end_headers(); return
        rb = r.encode(); s.send_response(200); s._cors()
        s.send_header("Content-Type","application/json")
        s.send_header("Content-Length", str(len(rb))); s.end_headers(); s.wfile.write(rb)
    def do_GET(s):
        i = json.dumps({"server":"research-bridge","version":"4.0.0",
                        "tools":[t["name"] for t in TOOLS]}).encode()
        s.send_response(200); s._cors(); s.send_header("Content-Type","application/json")
        s.send_header("Content-Length", str(len(i))); s.end_headers(); s.wfile.write(i)
    def do_DELETE(s): s.send_response(200); s._cors(); s.end_headers()

def run_http(host, port):
    print(f"[research-bridge] HTTP on http://{host}:{port}/mcp", file=sys.stderr)
    print(f"[research-bridge] Tools: {[t['name'] for t in TOOLS]}", file=sys.stderr)
    HTTPServer((host, port), HTTPHandler).serve_forever()

def run_stdio():
    d = os.environ.get("MCP_DEBUG","").lower() in ("1","true","yes")
    buf = ""
    for line in sys.stdin:
        if not line.strip(): continue
        buf += line
        try: msg = json.loads(buf); buf = ""
        except json.JSONDecodeError: continue
        if not isinstance(msg, dict):
            if d: print(f"[mcp] ignoring {type(msg)}", file=sys.stderr)
            continue
        try: r = handle(msg)
        except Exception as e:
            if d: import traceback; traceback.print_exc(file=sys.stderr)
            r = err(msg.get("id"), -32603, str(e))
        if r is not None: sys.stdout.write(r+"\n"); sys.stdout.flush()

def main():
    p = argparse.ArgumentParser(description="MCP Research Bridge v4 — cached, deduplicated, ranked")
    p.add_argument("--http-port", type=int, help="HTTP port for llama.cpp WebUI")
    p.add_argument("--http-host", default="127.0.0.1")
    a = p.parse_args()
    run_http(a.http_host, a.http_port) if a.http_port else run_stdio()

if __name__ == "__main__":
    main()
